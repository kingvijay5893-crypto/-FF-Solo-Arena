# --- Firebase service account (Project settings > Service accounts > Generate new private key) ---
# REQUIRED. Never commit the real values or the downloaded JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Keep the \n escape sequences and wrap the whole value in double quotes.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# REQUIRED. Your frontend's origin, for CORS.
CORS_ORIGIN=http://localhost:5173

# Optional. Defaults to 4000.
PORT=4000
